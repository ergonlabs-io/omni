# ~/.omni/agents/codex.conf
# Overrides ~/.omni/omni.conf for `omni codex`.
#
# Everything here is commented out on purpose: a fresh install of omni
# changes nothing about how Codex behaves. Uncomment what you want.

# off | record | route. Inherited from [defaults] in omni.conf unless set.
# mode = "record"

[model_map]
# Not supported for codex: model rewriting is Anthropic-only for now. A
# model_map here is rejected with a clear message rather than silently
# ignored, so this section must stay empty.

[record]
# Capture request and response bodies, not just metadata.
# bodies = true
