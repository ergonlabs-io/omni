# omni.conf — omni configuration (TOML syntax)
#
# This is the only file omni needs: global defaults, the backends traffic can
# be routed to, and per-agent overrides.
#
# A repo-local ./.omni.conf can override `mode` and `route` for one project,
# and OMNI_* environment variables override both. `omni config show` reports
# which file and line won for every value.

[defaults]
# off | record
#   off     passthrough — forward only, apply no rules, record nothing
#   record  intercept: apply routing rules, and allow recording (default)
# Routing needs no mode of its own: the rules below apply whenever you have
# written any and mode is not "off".
mode = "record"

# Write each session's traffic to ~/.omni/sessions. OFF by default, and
# separate from `mode` on purpose: routing is invisible, but a recording holds
# the prompts your agent sent — which routinely carry source code and secrets
# out of your working directory — so it is something you turn on, per run with
# `omni --record <agent>`, or here to make it the default.
record.enabled = false

# Strip Authorization / x-api-key / *-api-key from recorded traffic. Applies
# only when recording. Recordings still contain request and response bodies,
# which redaction does not sanitize — see the note in `omni help`.
redact = true


# --- backends --------------------------------------------------------------
# Places a routing rule can send traffic instead of the agent's own provider.
# Only needed if you write routing rules. Backends are global (an endpoint is an
# endpoint); rules are per-agent, because "claude-opus-5" is meaningless to
# Codex.
#
# omni routes; it does not translate. api_style must match the agent's own,
# so point base_url at a native endpoint or at a translating gateway — a
# mismatch is rejected at load rather than forwarded and hoped over.
#
# base_url is the origin plus any prefix, and stops there: omni appends the
# agent's own request path. The URL a provider prints in its own docs
# usually includes the version segment ("https://openrouter.ai/api/v1"),
# which is one segment too many here — it would make omni request
# /api/v1/v1/messages. `omni config check` warns if you leave it on.
#
# The credential is named, never written here: api_key_env holds a variable
# name, and a key pasted into this file is refused at load. At launch omni
# looks that variable up first in its own environment and then in
# ~/.omni/credentials — a plain NAME=value file that `omni init` has
# already created next to this one, at mode 0600, with the line you want
# sitting in it commented out:
#
#   OPENROUTER_API_KEY=sk-or-v1-...
#
# The difference between the two is who else sees the key. A variable you
# export is inherited by the agent omni launches; one kept in the
# credentials file is used by omni alone and never enters the agent's
# environment. Omit api_key_env only for a loopback endpoint wanting no auth.
#
# [backends.openrouter]
# base_url    = "https://openrouter.ai/api"   # origin + prefix; see above
# api_key_env = "OPENROUTER_API_KEY"
# api_style   = "anthropic"
# model       = "minimax/minimax-m3:free"     # what to ask this backend for
#
# [backends.openrouter.headers]
# HTTP-Referer = "https://github.com/ergonlabs-io/omni"
# X-Title      = "omni"


# --- per-agent -------------------------------------------------------------
# Anything in [defaults] can be set per agent here, plus `binary`, `upstream`,
# routing rules, and extra child environment.
[agents.claude]
# mode           = "off"
# record.enabled = true
# redact         = false

# Override the launched executable, or the endpoint it is pointed at.
# binary   = "/Users/me/.local/bin/claude"
# upstream = "https://api.anthropic.com"

# Extra environment for the child process. Never overrides omni's own
# steering variables (ANTHROPIC_BASE_URL and friends) — those always win.
# [agents.claude.env]
# ANTHROPIC_LOG = "debug"

# Routing rules: an ordered list, first match wins, in the order written.
# `match` is a glob against the model the agent asked for, and nothing else —
# that is what keeps routing deterministic, and therefore cache-safe.
#
# A rule sends the request to `backend`, or renames the model in place with
# `model`, or both. An unmatched request goes to the agent's own upstream,
# byte for byte, exactly as if routing were off.
#
# [[agents.claude.route]]
# match   = "claude-haiku-4-5*"    # the alias and the dated id, in one rule
# backend = "openrouter"
#
# [[agents.claude.route]]
# match = "claude-opus-*"
# model = "claude-sonnet-5"        # same provider, cheaper model

[agents.codex]
# mode = "record"
# Routing is Anthropic-only for now; a rule here is rejected with a clear
# message rather than silently ignored.
