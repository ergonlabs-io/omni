# omni credentials — API keys for routed backends, and nothing else.
#
# One NAME=value per line. The name is the one a backend's api_key_env
# points at:
#
#   [backends.openrouter]              # in omni.conf
#   api_key_env = "OPENROUTER_API_KEY" # ← resolved from the line below
#
# omni checks its own environment first and this file second, so exporting
# the variable in a shell still wins for a one-off override. The difference
# is who else sees the key: a variable you export is inherited by the agent
# omni launches, while one kept here is used by omni alone and never enters
# the agent's environment.
#
# This file must stay mode 0600 or stricter. omni refuses to read a
# credentials file others can read, rather than leave a key exposed —
# `omni init` created this one 0600, so uncommenting a line is all it takes.
#
# Nothing here is ever printed by `omni config show`, written into a session
# recording, or handed to the launched agent. A key written into omni.conf
# instead is refused at load; this is the one file in the tree it may go in.
#
# OPENROUTER_API_KEY=sk-or-v1-...
