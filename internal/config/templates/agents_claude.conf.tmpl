# ~/.omni/agents/claude.conf
# Overrides ~/.omni/omni.conf for `omni claude`.
#
# Everything here is commented out on purpose: a fresh install of omni
# changes nothing about how Claude Code behaves. Uncomment what you want.

# off | record | route. Inherited from [defaults] in omni.conf unless set.
# mode = "route"

# Override the launched executable. Useful for pinning a version or pointing
# at a local build.
# binary = "/Users/me/.local/bin/claude"

[model_map]
# Rewrite model names on the wire. LHS is what the agent sends, RHS is what
# omni forwards. Requires mode = "route"; nothing is rewritten while this
# section is empty.
#
# Resolved once per session rather than per request: a model that changes
# mid-conversation discards the cached prompt prefix and costs more than the
# routing saves.
# "claude-opus-5" = "claude-sonnet-5"

[adapt]
# error | warn. What to do when a request uses a feature the target model
# cannot express.
# on_unrepresentable = "error"

[record]
# Capture request and response bodies, not just metadata.
# bodies = true

[env]
# Extra env injected into the child. Does not override omni's own steering
# vars (ANTHROPIC_BASE_URL etc.) — those always win.
# ANTHROPIC_LOG = "debug"
